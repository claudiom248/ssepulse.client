<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <PackageId>SsePulse.Client</PackageId>
        <IsAotCompatible>true</IsAotCompatible>
        <NoWarn>$(NoWarn);AD0001</NoWarn>
        <Description>SsePulse.Client is a .NET library for consuming Server-Sent Events (SSE) streams, providing a simple and efficient way to handle real-time data updates from servers.</Description>
        <PackageTags>server-sent-events;sse;sse-consumer;sse-stream;ssepulse;ssepulse-client;client</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="System.Net.ServerSentEvents" />
        <PackageReference Include="System.Text.Json" />
    </ItemGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="SsePulse.Client.Tests" />
        <InternalsVisibleTo Include="SsePulse.Client.DependencyInjection" />
        <InternalsVisibleTo Include="SsePulse.Client.DependencyInjection.Tests" />
        <InternalsVisibleTo Include="SsePulse.Client.Extensions.Stores.Mongo.DependencyInjection.Tests" />
        <InternalsVisibleTo Include="SsePulse.Client.Extensions.Stores.DistributedCache.DependencyInjection.Tests" />
        <InternalsVisibleTo Include="SsePulse.Client.Tests.Common" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>
    

</Project>
